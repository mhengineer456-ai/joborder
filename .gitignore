# =================================================================
# ENTERPRISE SECURITY - GITIGNORE CONFIGURATION
# Prevents accidental credential leaks to GitHub & public repos
# =================================================================

# Environment Variables & Secret Files (CRITICAL - DO NOT COMMIT)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
!.env.example

# Backend Environment & Local Storage
backend/.env
backend/.env.*
!backend/.env.example
backend/.data/
backend/data/
backend/*.json
!backend/package.json
!backend/package-lock.json
!backend/railway.json

# Security Keys & SSL Certificates
*.pem
*.key
*.pfx
*.p12
*.crt

# Node Dependencies
/node_modules
backend/node_modules
/.pnp
.pnp.js

# Build Outputs
/build
/dist
/.vercel
/.railway

# Testing & Coverage
/coverage

# Debug Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS & Editor Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
